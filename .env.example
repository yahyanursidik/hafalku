# Public, non-sensitive application configuration.
VITE_APP_NAME=Hafalku

# Server-only. Never expose this value through VITE_ variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
LOG_LEVEL=info

# Server-only Contabo S3-compatible storage. Never expose these through VITE_ variables.
S3_ENDPOINT=https://eu2.contabostorage.com
S3_REGION=EU
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=hafalku
S3_PUBLIC_BASE_URL=https://your-public-audio-domain.example/hafalku
